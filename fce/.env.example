# FlareKeeper FCE — environment for local / Coston2 deployment.
# Copy to .env and fill in. Resolved by docker-compose.yaml.

# Extension implementation language (Python handler).
LANGUAGE=python

# Funded private key for the ext-proxy signing. Use the Hardhat dev key for
# local e2e; a real funded Coston2 key (from flare.network/coston2 faucet) for
# testnet deployment.
PROXY_PRIVATE_KEY="983760a4ebf75b2ac3a93531168a0f225d01e5dc6e3568adbd46233ba1fb4fa4"

# Initial owner / deployer address (derived from DEPLOYMENT_PRIVATE_KEY).
INITIAL_OWNER="0xF4E021377420Afe90c1A7D2b8968904946633a64"

# TEE governance — the signer set + threshold that governs this extension's TEE
# machines. post-build registers it on-chain (set-governance) AND the TEE node
# signs with it; both read these same vars. Defaults to GOVERNANCE_SIGNERS=<INITIAL_OWNER>
# threshold 1 if unset.
# GOVERNANCE_SIGNERS="0xAbc...,0xDef..."
# GOVERNANCE_THRESHOLD=2

# Chain RPC URL (Coston2).
CHAIN_URL=https://coston2-api.flare.network/ext/C/rpc

# Must be false on live networks.
LOCAL_MODE=false

# TEE attestation mode: true = simulated test code hash/platform (no real TEE
# hardware). Set to false on a real Confidential VM with genuine attestation.
SIMULATED_TEE=true

# Normal/FTDC proxy URL on Coston2.
NORMAL_PROXY_URL=https://tee-proxy-coston2-1.flare.rocks

# Extension proxy URL (your ngrok / public endpoint used to register the FCE).
# EXT_PROXY_URL=https://<your-ngrok-url>.ngrok-free.dev

# --- Docker Compose overrides (all have defaults) ---
# SOURCE_DATE_EPOCH=
# CHAIN_ID=114
# LOG_LEVEL=INFO
# MODE=1
# REDIS_BIND=127.0.0.1:6382
# EXT_PROXY_INTERNAL_BIND=0.0.0.0:6673
# EXT_PROXY_EXTERNAL_BIND=0.0.0.0:6674
# COMPOSE_NETWORK=flarekeeper-fce-coston2
# TEE_NODE_REF=
