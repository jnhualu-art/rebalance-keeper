# ── KeeperHub MCP ──
# API Key from app.keeperhub.com → Settings → API Keys (kh_ prefix)
KEEPERHUB_API_KEY=kh_your_api_key_here

# MCP endpoint (usually don't change)
KEEPERHUB_MCP_URL=https://app.keeperhub.com/mcp

# ── Wallet ──
# Your KeeperHub Turnkey wallet address
WALLET_ADDRESS=0x1573C3d151200922375bC48012BB1f232B2cF531

# Wallet integration ID (from list_integrations)
WALLET_INTEGRATION_ID=flx4bwzye6tb6re68wost

# ── Chain ──
# 11155111 = Sepolia testnet, 1 = Ethereum mainnet
CHAIN_ID=11155111

# ── Rebalancer config (optional, defaults are sensible) ──
# HEALTH_FACTOR_THRESHOLD=1.5
# REPAY_FRACTION=0.15
# MONITOR_INTERVAL=30
